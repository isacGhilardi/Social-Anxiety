<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Social_Anxiety.Controls"
    x:Class="Social_Anxiety.Views.MeditacaoGuiadaPage"
    Title="Meditação guiada"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="Container"
    BackgroundColor="{AppThemeBinding Light={StaticResource CalmeBg}, Dark={StaticResource CalmeBgDark}}">

    <!-- Sem a barra do Shell: o "Voltar" próprio (meditacao-voltar) faz o papel da seta. Cores só por tokens Calme. -->
    <Grid RowDefinitions="*,Auto">
    <ScrollView>
        <VerticalStackLayout Padding="24,8,24,24" Spacing="16">

            <Button
                Text="‹  Voltar"
                Clicked="OnVoltarClicked"
                AutomationId="meditacao-voltar"
                SemanticProperties.Description="Voltar"
                Style="{StaticResource CalmeLinkButton}"
                HorizontalOptions="Start"
                Padding="0,8" />

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="MOMENTO DE PAUSA"
                    Style="{StaticResource FlowEyebrow}"
                    TextColor="{AppThemeBinding Light={StaticResource CalmeTeal}, Dark={StaticResource CalmeTealDark}}" />

                <Label
                    Text="Meditação guiada"
                    AutomationId="meditacao-title"
                    SemanticProperties.HeadingLevel="Level1"
                    Style="{StaticResource FlowHeading}" />

                <Label
                    Text="Encontre um lugar confortável e reserve alguns minutos para você."
                    Style="{StaticResource FlowCopy}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource FlowCard}">

                <VerticalStackLayout Spacing="12">

                    <Border
                        BackgroundColor="{AppThemeBinding Light={StaticResource CalmeMint}, Dark={StaticResource CalmeMintDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        HeightRequest="190">

                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="10">

                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource CalmeMint}, Dark={StaticResource CalmeMintDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource CalmeSupportBorder}, Dark={StaticResource CalmeSupportBorderDark}}"
                                StrokeThickness="1.5"
                                StrokeShape="Ellipse"
                                WidthRequest="100"
                                HeightRequest="100">

                                <Label
                                    Text="◉"
                                    SemanticProperties.Description="Círculo de respiração"
                                    FontSize="54"
                                    TextColor="{AppThemeBinding Light={StaticResource CalmeTeal}, Dark={StaticResource CalmeTealDark}}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>

                            <Label
                                Text="Respire. Este momento é seu."
                                Style="{StaticResource FlowCopy}"
                                TextColor="{AppThemeBinding Light={StaticResource CalmeTeal}, Dark={StaticResource CalmeTealDark}}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Calma e presença"
                            Style="{StaticResource FlowCardTitle}" />

                        <Label
                            Text="Meditação para iniciantes • 5 minutos"
                            Style="{StaticResource FlowCopy}" />
                        <!-- US17: o MVP não tem áudio; a tela precisa dizer que é uma simulação. -->
                        <Label
                            Text="Esta versão não tem áudio: o cronômetro acompanha você enquanto segue os passos abaixo."
                            AutomationId="meditacao-sem-audio"
                            Style="{StaticResource FlowCopy}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <ProgressBar
                            x:Name="Progresso"
                            AutomationId="meditacao-progresso"
                            SemanticProperties.Description="Progresso da meditação"
                            Progress="0"
                            ProgressColor="{AppThemeBinding Light={StaticResource CalmeTeal}, Dark={StaticResource CalmeTealDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CalmeTrack}, Dark={StaticResource CalmeTrackDark}}"
                            HeightRequest="7" />

                        <Grid ColumnDefinitions="*,*">
                            <Label
                                x:Name="TempoAtual"
                                AutomationId="meditacao-tempo"
                                Text="00:00"
                                Style="{StaticResource FlowSmall}" />

                            <Label
                                Text="05:00"
                                Grid.Column="1"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource FlowSmall}" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Ação principal da tela; o texto muda no code-behind (Iniciar/Pausar/Repetir). -->
                    <Button
                        x:Name="BotaoReproduzir"
                        Text="▶  Iniciar meditação"
                        Clicked="OnReproduzirClicked"
                        AutomationId="meditacao-reproduzir"
                        Style="{StaticResource CalmeButton}" />

                    <Button
                        Text="Recomeçar sessão"
                        Clicked="OnRecomecarClicked"
                        AutomationId="meditacao-recomecar"
                        Style="{StaticResource CalmeLinkButton}" />

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource FlowCard}">

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Durante a prática"
                        Style="{StaticResource FlowCardTitle}" />

                    <Label
                        Text="1. Encontre uma posição confortável."
                        Style="{StaticResource FlowCopy}" />

                    <Label
                        Text="2. Perceba sua respiração sem tentar controlá-la."
                        Style="{StaticResource FlowCopy}" />

                    <Label
                        Text="3. Se sua atenção se dispersar, volte gentilmente ao momento presente."
                        Style="{StaticResource FlowCopy}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
        <controls:SupportButton Grid.Row="1" Margin="24,8,24,12" />
    </Grid>
</ContentPage>
