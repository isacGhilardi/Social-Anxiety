<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Social_Anxiety.MainPage" Title="Início" Style="{StaticResource FlowPage}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="24,8,24,28" Spacing="16">
                <Label x:Name="Greeting" Text="Olá, que bom ter você." AutomationId="home-greeting" Style="{StaticResource FlowHeading}" SemanticProperties.HeadingLevel="Level1"/>
                <Label Text="Que tal um pequeno cuidado agora?"  Style="{StaticResource FlowCopy}" />
                <Border Style="{StaticResource FlowCard}" BackgroundColor="{AppThemeBinding Light={StaticResource CalmeBlue}, Dark={StaticResource CalmeBlueDark}}"><VerticalStackLayout Spacing="12">
                <Label Text="Como você está hoje?"  Style="{StaticResource FlowCardTitle}" />
                <Label Text="Um minuto para perceber e acolher o que você sente."  Style="{StaticResource FlowCopy}" />
                <Button Text="Fazer check-in" Clicked="OnCheckinClicked" AutomationId="home-checkin" Style="{StaticResource CalmeButton}" />
                </VerticalStackLayout></Border>
                <Border Style="{StaticResource FlowCard}" BackgroundColor="{AppThemeBinding Light={StaticResource CalmeSurface}, Dark={StaticResource CalmeSurfaceDark}}"><VerticalStackLayout Spacing="12">
                <Label Text="Seus últimos 7 dias"  Style="{StaticResource FlowCardTitle}" />
                <Label Text="Seus registros aparecerão aqui. Faça seu primeiro check-in para começar a acompanhar sua semana." x:Name="EmptyMessage" Style="{StaticResource FlowCopy}" />
                <GraphicsView x:Name="SummaryGraph" AutomationId="home-graph" HeightRequest="160" />
                <Label Text="" x:Name="LatestScore" Style="{StaticResource FlowCopy}" AutomationId="home-latest"/>
                <Label Text="Ansiedade percebida: 1 = pouca; 5 = muita."  Style="{StaticResource FlowSmall}" />
                </VerticalStackLayout></Border>
                <Label Text="" x:Name="ErrorMessage" Style="{StaticResource FlowCopy}" AutomationId="home-error"/>
                <Button Text="Ver meu histórico" Clicked="OnHistoryClicked" AutomationId="home-history" Style="{StaticResource CalmeButton}" />
                <Button Text="Respiração guiada" Clicked="OnBreatheClicked" AutomationId="home-breathe" Style="{StaticResource CalmeTextButton}" />
                <Button Text="Técnicas" Clicked="OnTechniquesClicked" AutomationId="home-techniques" Style="{StaticResource CalmeTextButton}" />
                <Button Text="Meditação guiada" Clicked="OnMeditacaoGuiadaClicked" AutomationId="home-meditacao" Style="{StaticResource CalmeTextButton}" />
                <Button Text="Desafios" Clicked="OnChallengesClicked" AutomationId="home-challenges" Style="{StaticResource CalmeTextButton}" />
                <Button Text="Meu espaço" Clicked="OnProfileClicked" AutomationId="home-profile" Style="{StaticResource CalmeTextButton}" />

            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1" Padding="24,8,24,12" Spacing="8">
            <Button Text="Preciso de apoio agora" Clicked="OnSupportClicked" AutomationId="open-support" Style="{StaticResource FlowSupportButton}" />
            <controls:BottomNavBar xmlns:controls="clr-namespace:Social_Anxiety.Controls" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
