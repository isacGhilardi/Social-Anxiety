<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:local="clr-namespace:Social_Anxiety"
             xmlns:checkins="clr-namespace:Social_Anxiety.Core.CheckIns"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Social_Anxiety.HistoryPage" Title="Histórico" Style="{StaticResource FlowPage}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="24,8,24,28" Spacing="16">
                <Label Text="Seus registros"  Style="{StaticResource FlowHeading}" SemanticProperties.HeadingLevel="Level1"/>
                <Label Text="Observe o que muda ao longo do tempo, sem se cobrar."  Style="{StaticResource FlowCopy}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button x:Name="WeekButton" Text="Semana" Clicked="OnPeriodClicked" AutomationId="history-week" Style="{StaticResource CalmeButton}" CommandParameter="7"/>
                <Button x:Name="MonthButton" Text="Mês" Clicked="OnPeriodClicked" AutomationId="history-month" Style="{StaticResource CalmeTextButton}" Grid.Column="1" CommandParameter="30"/>
                </Grid>
                <Label Text="Últimos 7 dias" x:Name="PeriodLabel" Style="{StaticResource FlowCopy}" AutomationId="history-period"/>
                <GraphicsView x:Name="HistoryGraph" AutomationId="history-graph" HeightRequest="160" />
                <ActivityIndicator x:Name="LoadingIndicator" AutomationId="history-loading" IsVisible="False" IsRunning="False" />
                <Label x:Name="ChartLegend" Style="{StaticResource FlowCopy}" />
                <Label Text="" x:Name="RecordCount" Style="{StaticResource FlowCopy}" AutomationId="history-count"/>
                <Label Text="Nenhum registro neste período." x:Name="EmptyMessage" Style="{StaticResource FlowCopy}" />
                <Label Text="" x:Name="ErrorMessage" Style="{StaticResource FlowCopy}" AutomationId="history-error"/>
                <VerticalStackLayout x:Name="RecordList" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="checkins:CheckIn">
                            <Border Style="{StaticResource FlowCard}" Padding="0">
                                <Grid>
                                    <VerticalStackLayout Padding="16" Spacing="4" InputTransparent="True">
                                        <Label Text="{Binding Day}" Style="{StaticResource FlowCardTitle}"/>
                                        <Label Text="{Binding Summary}" Style="{StaticResource FlowCopy}"/>
                                    </VerticalStackLayout>
                                    <Button Style="{StaticResource CalmeTextButton}" Text=" " SemanticProperties.Description="{Binding Day}" CommandParameter="{Binding Id}" Clicked="OnRecordClicked" MinimumHeightRequest="88" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Text="Voltar ao início" Clicked="OnHomeClicked" AutomationId="history-home" Style="{StaticResource CalmeTextButton}" />

            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1" Padding="24,8,24,12" Spacing="8">
            <Button Text="Preciso de apoio agora" Clicked="OnSupportClicked" AutomationId="open-support" Style="{StaticResource FlowSupportButton}" />
            <controls:BottomNavBar xmlns:controls="clr-namespace:Social_Anxiety.Controls" Active="History" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
