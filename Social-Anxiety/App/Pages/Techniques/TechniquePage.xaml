<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:techniques="clr-namespace:Social_Anxiety.Core.Techniques"
    x:Class="Social_Anxiety.TechniquePage"
    Title="Sua prática"
    Style="{StaticResource FlowPage}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView x:Name="ContentScroll">
            <VerticalStackLayout Padding="24,8,24,24" Spacing="16">
                <Label x:Name="MissingMessage" Text="Esta técnica não está disponível. Escolha uma das práticas da biblioteca." IsVisible="False" Style="{StaticResource FlowCopy}" AutomationId="technique-error" />
                <VerticalStackLayout x:Name="PracticeContent" Spacing="16">
                    <Border x:Name="TechniqueBadge" Style="{StaticResource FlowCard}" Padding="12,6" HorizontalOptions="Start" BackgroundColor="{AppThemeBinding Light={StaticResource CalmeMint}, Dark={StaticResource CalmeMintDark}}">
                        <Label x:Name="TechniqueTag" Style="{StaticResource FlowEyebrow}" />
                    </Border>
                    <Label x:Name="TechniqueTitle" Style="{StaticResource FlowHeading}" SemanticProperties.HeadingLevel="Level1" AutomationId="technique-title" />
                    <Label x:Name="TechniqueDescription" Style="{StaticResource FlowCopy}" />
                    <VerticalStackLayout x:Name="StepsList" Spacing="16" AutomationId="technique-steps">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="techniques:TechniqueStep">
                                <Border Style="{StaticResource FlowCard}">
                                    <Grid ColumnDefinitions="40,*" ColumnSpacing="12">
                                        <Label Text="{Binding Marker}" Style="{StaticResource FlowCardTitle}" HorizontalTextAlignment="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                                            <Label Text="{Binding Title}" Style="{StaticResource FlowCardTitle}" SemanticProperties.HeadingLevel="Level2" />
                                            <Label Text="{Binding Description}" Style="{StaticResource FlowCopy}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Se a prática aumentar seu desconforto, interrompa. Você pode manter os olhos abertos, olhar um objeto ao redor ou trocar de prática. Não precisa insistir para concluir." Style="{StaticResource FlowCopy}" />
                    <Button Text="Concluir minha prática" Clicked="OnCompleteClicked" AutomationId="technique-complete" Style="{StaticResource CalmeButton}" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="FinishContent" Spacing="16" IsVisible="False">
                    <Image Source="leaf.png" HeightRequest="80" SemanticProperties.Description="Folha, símbolo de uma pausa" />
                    <Label Text="Uma pausa conta." Style="{StaticResource FlowHeading}" SemanticProperties.HeadingLevel="Level1" AutomationId="technique-finish-title" />
                    <Label Text="Obrigado por reservar esse momento para você. Não é preciso se sentir diferente imediatamente." Style="{StaticResource FlowCopy}" />
                    <Label Text="Volte ao seu dia no ritmo que for possível." Style="{StaticResource FlowCopy}" />
                    <!-- Secundário: a tela já tem um primário (technique-complete), mesmo que os dois estados não apareçam juntos. -->
                    <Button Text="Voltar ao início" Clicked="OnHomeClicked" AutomationId="technique-home" Style="{StaticResource CalmeSecondaryButton}" />
                </VerticalStackLayout>
                <Button Text="Ver outras técnicas" Clicked="OnLibraryClicked" AutomationId="technique-library" Style="{StaticResource CalmeSecondaryButton}" />
                <Label Text="Este app não substitui acompanhamento profissional e não realiza diagnósticos." Style="{StaticResource FlowSmall}" />
                <Label Text="Se a ansiedade persistir ou atrapalhar seu dia a dia, procure avaliação profissional. Não é preciso esperar ficar pior para buscar ajuda." Style="{StaticResource FlowCopy}" />
                <Button Text="Buscar ajuda profissional" Clicked="OnHelpClicked" AutomationId="technique-help" Style="{StaticResource CalmeSecondaryButton}" />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1" Margin="24,8,24,12" Text="Preciso de apoio agora" Clicked="OnSupportClicked" AutomationId="open-support" Style="{StaticResource FlowSupportButton}" />
    </Grid>
</ContentPage>
