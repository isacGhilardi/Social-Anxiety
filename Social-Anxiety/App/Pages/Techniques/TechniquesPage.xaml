<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Social_Anxiety.Controls"
    x:Class="Social_Anxiety.TechniquesPage"
    Title="Técnicas"
    Style="{StaticResource FlowPage}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="24,8,24,24" Spacing="16">
                <Label Text="PRÁTICAS PARA O SEU DIA" Style="{StaticResource FlowEyebrow}" />
                <Label Text="Seu tempo de cuidado." Style="{StaticResource FlowHeading}" SemanticProperties.HeadingLevel="Level1" AutomationId="techniques-title" />
                <Label Text="Experimente uma prática por vez. Não é preciso fazer tudo." Style="{StaticResource FlowCopy}" />
                <!-- Cartões com ícone, nome e subtítulo, montados no code-behind a partir do TechniqueCatalog. -->
                <VerticalStackLayout x:Name="TechniqueCards" Spacing="12" />
                <Label Text="Escolha o que funciona para você. Essas práticas não substituem acompanhamento profissional." Style="{StaticResource FlowSmall}" />
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1" Spacing="0">
            <Button Margin="24,8,24,10" Text="Preciso de apoio agora" Clicked="OnSupportClicked" AutomationId="open-support" Style="{StaticResource FlowSupportButton}" />
            <controls:BottomNavBar Active="Techniques" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
