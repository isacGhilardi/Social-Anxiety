<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Social_Anxiety.ChallengesPage"
    Title="Desafios"
    Style="{StaticResource FlowPage}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="24,8,24,28" Spacing="16">
                <Label Text="MICRODESAFIOS" Style="{StaticResource FlowSmall}" />
                <Label Text="Sua trilha de pequenos passos." Style="{StaticResource FlowHeading}" SemanticProperties.HeadingLevel="Level1" AutomationId="challenges-title" />
                <Label Text="Um nível de cada vez, no seu ritmo." Style="{StaticResource FlowCopy}" />
                <Label x:Name="ProgressText" Style="{StaticResource FlowSmall}" AutomationId="challenges-progress" />
                <Label x:Name="ErrorMessage" Style="{StaticResource FlowCopy}" AutomationId="challenges-error" />
                <VerticalStackLayout x:Name="LevelCards" Spacing="12" />
                <Label Text="CONQUISTAS" Style="{StaticResource FlowSmall}" SemanticProperties.HeadingLevel="Level2" />
                <VerticalStackLayout x:Name="AchievementCards" Spacing="12" AutomationId="challenges-achievements" />
                <Button Text="Voltar ao início" Clicked="OnHomeClicked" AutomationId="challenges-home" Style="{StaticResource CalmeTextButton}" />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1" Margin="24,8,24,12" Text="Preciso de apoio agora" Clicked="OnSupportClicked" AutomationId="open-support" Style="{StaticResource FlowSupportButton}" />
    </Grid>
</ContentPage>
