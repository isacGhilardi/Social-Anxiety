<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Social_Anxiety.ChallengeLockedPage"
    Title="Nível bloqueado"
    Style="{StaticResource FlowPage}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="24,8,24,28" Spacing="16">
                <VerticalStackLayout x:Name="LockedContent" Spacing="16">
                    <Label x:Name="LevelTag" Style="{StaticResource FlowSmall}" />
                    <Label Text="Um passo de cada vez." Style="{StaticResource FlowHeading}" SemanticProperties.HeadingLevel="Level1" AutomationId="locked-title" />
                    <Label Text="Este nível fica disponível depois do desafio anterior. Você pode chegar lá no seu próprio tempo." Style="{StaticResource FlowCopy}" />
                    <Border Style="{StaticResource FlowCard}" BackgroundColor="{AppThemeBinding Light={StaticResource CalmeLilac}, Dark={StaticResource CalmeLilacDark}}" AutomationId="locked-missing">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="O QUE FALTA" Style="{StaticResource FlowSmall}" />
                            <Label x:Name="MissingTitle" Style="{StaticResource FlowCardTitle}" />
                            <Label x:Name="MissingDescription" Style="{StaticResource FlowCopy}" />
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="Seu progresso não tem prazo. Adiar um desafio não apaga o que você já fez." Style="{StaticResource FlowCopy}" />
                </VerticalStackLayout>
                <Label x:Name="StatusMessage" Style="{StaticResource FlowCopy}" IsVisible="False" AutomationId="locked-message" />
                <Button Text="Voltar à trilha" Clicked="OnBackClicked" AutomationId="locked-back" Style="{StaticResource CalmeButton}" />
                <Button Text="Explorar uma técnica" Clicked="OnLibraryClicked" AutomationId="locked-library" Style="{StaticResource CalmeTextButton}" />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1" Margin="24,8,24,12" Text="Preciso de apoio agora" Clicked="OnSupportClicked" AutomationId="open-support" Style="{StaticResource FlowSupportButton}" />
    </Grid>
</ContentPage>
