<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Social_Anxiety.ChallengeDonePage"
    Title="Desafio concluído"
    Style="{StaticResource FlowPage}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="24,8,24,28" Spacing="16">
                <Image Source="leaf.png" HeightRequest="80" SemanticProperties.Description="Folha, símbolo de um passo dado" />
                <Label x:Name="LevelTag" Style="{StaticResource FlowSmall}" />
                <Label Text="Você deu um passo." Style="{StaticResource FlowHeading}" SemanticProperties.HeadingLevel="Level1" AutomationId="done-title" />
                <Label Text="Obrigado por tentar. Não importa como foi: seu esforço conta." Style="{StaticResource FlowCopy}" />
                <Border x:Name="AchievementCard" Style="{StaticResource FlowCard}" IsVisible="False" AutomationId="done-achievement" BackgroundColor="{AppThemeBinding Light={StaticResource CalmeLilac}, Dark={StaticResource CalmeLilacDark}}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="NOVA CONQUISTA" Style="{StaticResource FlowSmall}" />
                        <Label x:Name="AchievementName" Style="{StaticResource FlowCardTitle}" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Voltar para a trilha" Clicked="OnTrailClicked" AutomationId="done-trail" Style="{StaticResource CalmeButton}" />
                <Button Text="Voltar ao início" Clicked="OnHomeClicked" AutomationId="done-home" Style="{StaticResource CalmeTextButton}" />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1" Margin="24,8,24,12" Text="Preciso de apoio agora" Clicked="OnSupportClicked" AutomationId="open-support" Style="{StaticResource FlowSupportButton}" />
    </Grid>
</ContentPage>
