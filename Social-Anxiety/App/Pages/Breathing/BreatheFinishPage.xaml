<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Social_Anxiety.BreatheFinishPage" Title="Sua pausa" Style="{StaticResource FlowPage}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="24,8,24,24" Spacing="16">
                <Label Text="Um tempo para você."  Style="{StaticResource FlowHeading}" AutomationId="breathe-finish-title"/>
                <Border Style="{StaticResource FlowCard}" BackgroundColor="{AppThemeBinding Light={StaticResource CalmeMint}, Dark={StaticResource CalmeMintDark}}"><VerticalStackLayout Spacing="12">
                <Label Text="Cada pausa conta"  Style="{StaticResource FlowCardTitle}" />
                <Label Text="Você não precisa se sentir de um jeito específico depois da prática. Perceba como está agora, sem se cobrar."  Style="{StaticResource FlowCopy}" />
                </VerticalStackLayout></Border>
                <Label Text="Se precisar, você pode repetir a prática, escolher outro cuidado ou buscar ajuda profissional."  Style="{StaticResource FlowCopy}" />
                <Label Text="Este app não substitui acompanhamento profissional e não realiza diagnósticos."  Style="{StaticResource FlowSmall}" />
                <Label Text="Se a ansiedade persistir ou atrapalhar seu dia a dia, procure avaliação profissional. Se a prática aumentar o desconforto, você não precisa repeti-la." Style="{StaticResource FlowCopy}" />
                <Button Text="Voltar ao que eu estava fazendo" Clicked="OnReturnClicked" AutomationId="breathe-return" Style="{StaticResource CalmeButton}" />
                <Button Text="Praticar novamente" Clicked="OnAgainClicked" AutomationId="breathe-again" Style="{StaticResource CalmeSecondaryButton}" />
                <Button Text="Buscar ajuda profissional" Clicked="OnHelpClicked" AutomationId="breathe-finish-help" Style="{StaticResource CalmeSecondaryButton}" />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1" Margin="24,8,24,12" Text="Preciso de apoio agora" Clicked="OnSupportClicked" AutomationId="open-support" Style="{StaticResource FlowSupportButton}" />
    </Grid>
</ContentPage>
