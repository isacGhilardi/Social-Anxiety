<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Social_Anxiety.Controls.BottomNavBar">
    
    <Grid ColumnDefinitions="*,*,*,*,*"
            HeightRequest="80"
            BackgroundColor="{StaticResource White}">
        <Border Grid.Column="0"
                BackgroundColor="{StaticResource SoftBlue}"
                StrokeShape="RoundRectangle 100"
                StrokeThickness="0"
                Padding="16,8"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Label Text="Início" 
                   FontFamily="Nunito"
                   LineBreakMode="WordWrap"
                   MaxLines="1"
                   TextColor="{StaticResource Muted}"
                   FontSize="12"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
               />
        </Border>
        
        <Label Text="Histórico" Grid.Column="1"
               FontFamily="Nunito"
               TextColor="{StaticResource Muted}"
               FontSize="12"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               />
        <Label Text="Técnicas" Grid.Column="2"
               FontFamily="Nunito"
               TextColor="{StaticResource Muted}"
               FontSize="12"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               />
        <Label Text="Desafios" Grid.Column="3"
               FontFamily="Nunito"
               TextColor="{StaticResource Muted}"
               FontSize="12"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               />
        <Label Text="Perfil" Grid.Column="4"
               FontFamily="Nunito"
               TextColor="{StaticResource Muted}"
               FontSize="12"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               />
    </Grid>
</ContentView>
