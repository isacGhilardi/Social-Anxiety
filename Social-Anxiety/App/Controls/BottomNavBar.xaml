<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Social_Anxiety.Controls.BottomNavBar">

    <Grid
        ColumnDefinitions="*,*,*,*,*"
        HeightRequest="80"
        BackgroundColor="{AppThemeBinding Light={StaticResource CalmeBg}, Dark={StaticResource CalmeBgDark}}">

        <Border
            Grid.Column="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource SoftBlue}, Dark={StaticResource CalmeBlueDark}}"
            StrokeShape="RoundRectangle 100"
            StrokeThickness="0"
            Padding="8,8"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Label
                Text="Início"
                FontFamily="NunitoBold"
                FontSize="12"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource CalmePrimaryDark}}"
                LineBreakMode="NoWrap"
                MaxLines="1"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />
        </Border>

        <Label
            Grid.Column="1"
            Text="Histórico"
            FontFamily="Nunito"
            FontSize="12"
            TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource CalmeMutedDark}}"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />

        <Label
            Grid.Column="2"
            Text="Técnicas"
            FontFamily="Nunito"
            FontSize="12"
            TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource CalmeMutedDark}}"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />

        <Label
            Grid.Column="3"
            Text="Desafios"
            FontFamily="Nunito"
            FontSize="12"
            TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource CalmeMutedDark}}"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />

        <Label
            Grid.Column="4"
            Text="Perfil"
            FontFamily="Nunito"
            FontSize="12"
            TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource CalmeMutedDark}}"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />
    </Grid>
</ContentView>