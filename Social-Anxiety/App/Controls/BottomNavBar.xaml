<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Social_Anxiety.Controls.BottomNavBar">

    <Grid ColumnDefinitions="*,*,*,*,*"
          HeightRequest="80"
          BackgroundColor="{StaticResource White}">

        <Border Grid.Column="0"
                BackgroundColor="{StaticResource SoftBlue}"
                StrokeShape="RoundRectangle 100"
                StrokeThickness="0"
                Padding="16,8"
                HorizontalOptions="Center"
                VerticalOptions="Center">

            <Label Text="Início"
                   FontFamily="Nunito"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Muted}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"/>
        </Border>

        <Label Text="Histórico"
               Grid.Column="1"
               FontFamily="Nunito"
               TextColor="{StaticResource Muted}"
               FontSize="12"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"/>

        <Label Text="Técnicas"
               Grid.Column="2"
               FontFamily="Nunito"
               TextColor="{StaticResource Muted}"
               FontSize="12"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"/>

        <Button Grid.Column="3"
                Text="Desafios"
                FontFamily="Nunito"
                FontSize="12"
                TextColor="{StaticResource Muted}"
                BackgroundColor="Transparent"
                Padding="0"
                Clicked="OnDesafiosClicked"/>

        <Button Grid.Column="4"
                Text="Configurações"
                FontFamily="Nunito"
                FontSize="10"
                TextColor="{StaticResource Muted}"
                BackgroundColor="Transparent"
                Padding="0"
                Clicked="OnConfiguracoesClicked"/>

    </Grid>
</ContentView>