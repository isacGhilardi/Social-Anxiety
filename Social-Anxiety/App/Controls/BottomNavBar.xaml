<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Social_Anxiety.Controls.BottomNavBar">

    <ContentView.Resources>
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="FontFamily" Value="Nunito" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CalmeMuted}, Dark={StaticResource CalmeMutedDark}}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="NavItemActive" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CalmeText}, Dark={StaticResource CalmeTextDark}}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CalmeBlue}, Dark={StaticResource CalmeBlueDark}}" />
        </Style>
    </ContentView.Resources>

    <Grid ColumnDefinitions="*,*,*,*,*"
          HeightRequest="80"
          BackgroundColor="{AppThemeBinding Light={StaticResource CalmeSurface}, Dark={StaticResource CalmeSurfaceDark}}">

        <Button x:Name="HomeItem" Grid.Column="0"
                Text="Início"
                AutomationId="nav-home"
                Style="{StaticResource NavItem}"
                Clicked="OnItemClicked" />

        <Button x:Name="HistoryItem" Grid.Column="1"
                Text="Histórico"
                AutomationId="nav-history"
                Style="{StaticResource NavItem}"
                Clicked="OnItemClicked" />

        <Button x:Name="TechniquesItem" Grid.Column="2"
                Text="Técnicas"
                AutomationId="nav-techniques"
                Style="{StaticResource NavItem}"
                Clicked="OnItemClicked" />

        <Button x:Name="ChallengesItem" Grid.Column="3"
                Text="Desafios"
                AutomationId="nav-challenges"
                Style="{StaticResource NavItem}"
                Clicked="OnItemClicked" />

        <Button x:Name="SettingsItem" Grid.Column="4"
                Text="Configurações"
                AutomationId="nav-settings"
                Style="{StaticResource NavItem}"
                Clicked="OnConfiguracoesClicked" />
    </Grid>
</ContentView>
