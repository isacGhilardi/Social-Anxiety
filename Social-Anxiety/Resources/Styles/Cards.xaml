<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="LblCardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="Nunito" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
    </Style>

    <Style x:Key="LblCardBody" TargetType="Label">
        <Setter Property="FontFamily" Value="Nunito" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>

    <Style x:Key="CardBlue" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource SoftBlue}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="CardMint" TargetType="Border" BasedOn="{StaticResource CardBlue}">
        <Setter Property="BackgroundColor" Value="{StaticResource Mint}" />
    </Style>
    <Style x:Key="CardLilac" TargetType="Border" BasedOn="{StaticResource CardBlue}">
        <Setter Property="BackgroundColor" Value="{StaticResource Lilac}" />
    </Style>

    <Style x:Key="CardShortcut" TargetType="Border" BasedOn="{StaticResource CardBlue}">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="100" />
    </Style>
    <Style x:Key="CardShortcutBlue" TargetType="Border" BasedOn="{StaticResource CardShortcut}">
        <Setter Property="BackgroundColor" Value="{StaticResource SoftBlue}" />
    </Style>
    <Style x:Key="CardShortcutMint" TargetType="Border" BasedOn="{StaticResource CardShortcut}">
        <Setter Property="BackgroundColor" Value="{StaticResource Mint}" />
    </Style>
    <Style x:Key="CardShortcutLilac" TargetType="Border" BasedOn="{StaticResource CardShortcut}">
        <Setter Property="BackgroundColor" Value="{StaticResource Lilac}" />
    </Style>

    <Style x:Key="CardList" TargetType="Border" BasedOn="{StaticResource CardBlue}">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="88" />
    </Style>
    <Style x:Key="CardListMint" TargetType="Border" BasedOn="{StaticResource CardList}">
        <Setter Property="BackgroundColor" Value="{StaticResource Mint}" />
    </Style>
    <Style x:Key="CardListLilac" TargetType="Border" BasedOn="{StaticResource CardList}">
        <Setter Property="BackgroundColor" Value="{StaticResource Lilac}" />
    </Style>

    <Style x:Key="ListIconBox" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource SoftBlue}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="ListIconBoxOnTint" TargetType="Border" BasedOn="{StaticResource ListIconBox}">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
    </Style>

</ResourceDictionary>