<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Social_Anxiety.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Social_Anxiety"
    xmlns:views="clr-namespace:Social_Anxiety.Views"
    Title="Calme" FlyoutBehavior="Disabled" Shell.NavBarIsVisible="False">
    <!-- Tela neutra enquanto a sessão é lida; AppShell decide entre boas-vindas, acesso e início. -->
    <ShellContent Route="start">
        <ContentPage Shell.NavBarIsVisible="False" BackgroundColor="{AppThemeBinding Light={StaticResource CalmeBg}, Dark={StaticResource CalmeBgDark}}" />
    </ShellContent>
    <ShellContent ContentTemplate="{DataTemplate local:OnboardingPage}" Route="welcome" />
    <ShellContent ContentTemplate="{DataTemplate local:AccessPage}" Route="access" />
    <ShellContent Title="Início" ContentTemplate="{DataTemplate local:MainPage}" Route="home" />
    <ShellContent
    Title="Apoio imediato"
    ContentTemplate="{DataTemplate views:ApoioImediatoPage}"
    Route="apoio-imediato" />
</Shell>